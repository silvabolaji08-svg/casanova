# Copy this file to .env and fill in real values. .env is gitignored.

PORT=5000

# MongoDB Atlas connection string. Include the database name (/casanova) before the ?
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/casanova?retryWrites=true&w=majority

# Any long random string. Changing it invalidates every issued token.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the frontend runs. Comma-separated for more than one.
CLIENT_ORIGIN=http://localhost:5173